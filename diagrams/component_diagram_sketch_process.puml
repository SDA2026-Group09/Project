@startuml C4_component_sketch_process
!include <C4/C4_Component>

title Component diagram — Sketch process

Container_Boundary(sketch_process, "Sketch process") {
    Component(papplet, "PApplet", "Java", "Base class that every sketch extends. It exposes all drawing functions.")
    Component(animation_loop, "Animation loop", "Java", "Dedicated thread that invokes setup() and draw() at the target frame rate, and dispatches input events received from the window manager to PApplet callbacks.")
    Component(psurface, "Window manager", "Java / AWT / JOGL", "The window manager that handles window lifecycle, OS-level input events.")
    Component(pgraphics, "Render engine", "Java / Java2D / OpenGL", "It executes the processing drawing functions like shapes, colors, typography, images and geometric transforms. The default option is the Java2D, which is a 2D render engine. It also supports P2D and P3D.")
    Component(resource_management, "Resource management", "Java", "Provides utilities for handling fonts, images and shapes.")
}

Component(platform_layer, "Platform Layer", "Java / JNI", "Defined in PDE container. Abstracts OS-specific operations: native file paths, sketchbook location and process management.")

Container(java_mode, "Java Mode", "Java", "Version of the processing language based on java. It handles all the sketch lifecycle: preprocessing, compilation, built, execution. It offers also the possibility to debug the code and use the tweak mode.")
System_Ext(os, "Operating System", "It handles the access to the computer's files and to accelerated hardware")

/' Java Mode relationships '/
Rel(java_mode, papplet, "Spawns process and communicates runtime messages", "Sockets")

/' PApplet relationships '/
Rel(papplet, animation_loop, "Starts and controls the animation loop")
Rel(papplet, psurface, "Delegates window creation and management")
Rel(papplet, pgraphics, "Drawing request")
Rel(papplet, resource_management, "Requests image, shape and font loading")

/' Animation loop relationships '/
Rel(animation_loop, psurface, "Signals frame completion and requests display refresh")
Rel(animation_loop, papplet, "Invokes setup(), draw() and event callbacks")

/' Window manager relationships '/
Rel(psurface, platform_layer, "Requests native window handle and display info")

/' Render engine relationships '/
Rel(pgraphics, os, "Drawing requests to the GPU or CPU")

/' Resource management relationships '/
Rel(resource_management, platform_layer, "Resolves data / folder path")

/' Platform Layer is the only contact point with OS '/
Rel(platform_layer, os, "Native window creation, file I/O and drawing requests (to CPU or GPU)", "OS API")

@enduml